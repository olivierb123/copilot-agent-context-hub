# Server-side project identifiers; these are not secrets.
FOUNDRY_PROJECT_ENDPOINT=
HARNESS_AGENT_NAME=copilot-agent-context-hub
AZURE_TENANT_ID=

# Total turn and SDK request budget in milliseconds (60000-900000).
# Default ten minutes; no automatic inference retries.
HARNESS_TURN_TIMEOUT_MS=600000

# Fail-closed browser mode: requires configured MSAL, valid user token,
# and an explicit allowlist of Entra object IDs. Empty allowlist denies all.
HARNESS_AUTH_MODE=bearer
HARNESS_ALLOWED_OBJECT_IDS=
# Display-only object-ID to user-ID mapping, e.g. {"object-id":"user@example.com"}.
# This never adds recipients or changes the object-ID authorization allowlist.
HARNESS_USER_LABELS={}
VITE_HARNESS_LOCAL_MODE=false
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=

# For an explicit single-developer loopback demo ONLY, change both:
# HARNESS_AUTH_MODE=local
# VITE_HARNESS_LOCAL_MODE=true
# This uses DefaultAzureCredential, not browser-user or persona delegation.

# Native knowledge-base MCP and Fabric use Foundry connections in harness/azure.yaml;
# no Fabric service-principal settings or secrets are imported by this app.
